{
  "name": "@parel/agents-md",
  "version": "0.0.0",
  "description": "Loads AGENTS.md project instructions from the sandbox into the model's context.",
  "keywords": [
    "parel",
    "ai-agents",
    "agent-runtime",
    "parel-plugin",
    "coding-agent",
    "agents-md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parall-hq/parel-oss.git",
    "directory": "js/plugins/agents-md"
  },
  "bugs": {
    "url": "https://github.com/parall-hq/parel-oss/issues"
  },
  "homepage": "https://parel.sh/docs",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "parel.plugin.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
